{
  "manifest_version": 3,
  "name": "墨阅 · Ink",
  "version": "0.1.2",
  "description": "网页与 PDF 深色阅读，纯黑、磨砂、纸张三种材质，保留图片原色。",
  "minimum_chrome_version": "128",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "墨阅 · Ink" },
  "icons": { "16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["vendor/darkreader.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }],
  "web_accessible_resources": [{
    "resources": ["viewer.html", "assets/paper.svg"],
    "matches": ["<all_urls>"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  }
}
